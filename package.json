{
  "name": "hello_world",
  "version": "1.0.0",
  "description": "hello world sample for NodeJS",
  "main": "app.js",
  "repository": "https://github.com/wlckconsulting/sam-template",
  "author": "SAM CLI",
  "license": "MIT",
  "dependencies": {
    "axios": ">=1.3.4",
    "uuid": "^9.0.0"
  },
  "scripts": {
    "watch": "tsc --watch",
    "start:local": "tsc && cp package.json dist/ && cd dist && npm install --production && cd .. && sam local start-api",
    "clear": "rm -rf node_modules && rm -rf .aws-sam/build && rm -rf dist",
    "pre-build": "npm i && tsc && cp package.json dist/",
    "build": "npm install --omit=dev --prefix ./dist && sam build",
    "deploy": "npm run clear && npm run pre-build && npm run build && sam deploy"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.114",
    "@types/node": "^18.15.3",
    "@types/uuid": "^9.0.1",
    "aws-sdk": "^2.1338.0",
    "typescript": "^5.0.2"
  }
}
